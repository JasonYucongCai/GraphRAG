    {
      "channel_id": "a2a",
      "handler": "IPP_Social.IPP_Social_services_tools.IPP_Social_services_ipp_object:make_a2a_handler",
      "ipp_object": {
        "input": {
          "logical_type": "A2ARequest",
          "description": "{mode: sync|async|stream|push, ...} — the four formal A2A interaction modes",
          "schema": {
            "type": "object",
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "sync",
                  "async",
                  "stream",
                  "push"
                ]
              },
              "from_agent_id": {
                "type": "string"
              },
              "to_agent_id": {
                "type": "string"
              },
              "goal_id": {
                "type": "string"
              },
              "task_id": {
                "type": "string"
              },
              "agent_id": {
                "type": "string"
              }
            }
          }
        },
        "process": {
          "description": "Execute one of the four formal A2A methods: sync handoff (declared, currently disabled), async task (submit + poll status), stream subscription (event bus), push notification (chat-board scoped).",
          "kind": "agent"
        },
        "output": {
          "logical_type": "A2AResult",
          "description": "mode-specific result, a SocialStream, or {ok:false, error: mode_not_allowed|push_scope_denied|...}",
          "schema": null
        }
      },

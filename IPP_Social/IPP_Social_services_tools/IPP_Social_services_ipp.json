{
  "$schema": "https://ipp-spec.org/v0.2.8/schema.json",
  "ipp_version": "0.2.8",
  "node_id": "social_activity",
  "description": "The plug-and-play social layer: agent cards with capacity / random-property / constraints vectors, shared goal-task folders, a global chat board, a streaming event bus, and the four formal A2A interaction modes (sync declared-but-disabled; async + stream enabled; push scoped to the chat board).",
  "channels": [
    {
      "channel_id": "card",
      "handler": "IPP_Social.IPP_Social_services_tools.IPP_Social_services_ipp_object:make_card_handler",
      "ipp_object": {
        "input": {
          "logical_type": "SocialOp",
          "description": "{op: register|get|list|comment, ...} — register an agent card, discover cards, annotate another agent's card",
          "schema": {
            "type": "object",
            "anyOf": [
              {
                "description": "Discover the agent cards (names, ids, capacity).",
                "properties": {
                  "op": {
                    "const": "list"
                  }
                },
                "required": [
                  "op"
                ]
              },
              {
                "description": "Read one agent card.",
                "properties": {
                  "agent_id": {
                    "type": "string"
                  },
                  "op": {
                    "const": "get"
                  }
                },
                "required": [
                  "op",
                  "agent_id"
                ]
              },
              {
                "description": "Register an agent card.",
                "properties": {
                  "agent_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "bio": {
                    "type": "string"
                  },
                  "capacity": {
                    "type": "object"
                  },
                  "random_property": {
                    "type": "object"
                  },
                  "constraints": {
                    "type": "object"
                  },
                  "overwrite": {
                    "type": "boolean"
                  },
                  "op": {
                    "const": "register"
                  }
                },
                "required": [
                  "op",
                  "agent_id"
                ]
              },
              {
                "description": "Comment on an agent card.",
                "properties": {
                  "target_agent_id": {
                    "type": "string"
                  },
                  "author_id": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "op": {
                    "const": "comment"
                  }
                },
                "required": [
                  "op",
                  "target_agent_id",
                  "text"
                ]
              }
            ]
          }
        },
        "process": {
          "description": "Register an agent (capacity 10-dim identity, random property 10-dim mean/variance, constraints), discover via the Agent Card, or leave a comment on another agent's card.",
          "kind": "deterministic"
        },
        "output": {
          "logical_type": "AgentCard",
          "description": "an AgentCard, a list of AgentCards, or {ok:false, error:...}",
          "schema": null
        }
      },
      "ipp_executor": {
        "integrity": {
          "checksum_algorithm": "sha256",
          "signature_required": false,
          "verification_endpoint": null,
          "payload_validation_schema": {
            "type": "object",
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "type": "string"
              }
            }
          }
        },
        "policy": {
          "max_cost_per_call_usd": 0,
          "max_latency_ms": 30000,
          "rate_limit_rps": 0,
          "security_clearance": "social",
          "retry_policy": {
            "max_retries": 0,
            "backoff_strategy": "constant"
          }
        },
        "provenance": {
          "audit_level": "full",
          "log_endpoint": "graph_data/logs/IPP/social_activity.card.jsonl",
          "chain_of_custody": true
        },
        "error_handling": {
          "fallback_nodes": [],
          "circuit_breaker": {
            "failure_threshold": 5,
            "recovery_timeout_ms": 30000
          },
          "escalation_policy": {
            "max_escalation_depth": 1,
            "escalation_delay_ms": 1000
          }
        },
        "edge_capabilities": {
          "upstream_compatible": [],
          "downstream_compatible": [],
          "routing_modes": [
            "unicast"
          ],
          "constraint_envelope": {
            "max_parallel_edges": 8,
            "acknowledgment": "optional",
            "backpressure_modes": [
              "block",
              "buffer"
            ],
            "resolution_policy": "constructor_resolved"
          }
        }
      }
    },
    {
      "channel_id": "profile",
      "handler": "IPP_Social.IPP_Social_services_tools.IPP_Social_services_ipp_object:make_profile_handler",
      "ipp_object": {
        "input": {
          "logical_type": "SocialOp",
          "description": "{op: get|update_constraints, agent_id, constraints?} — read the 3-property profile or move the physical constraint vector",
          "schema": {
            "type": "object",
            "required": [
              "op",
              "agent_id"
            ],
            "properties": {
              "op": {
                "enum": [
                  "get",
                  "update_constraints"
                ]
              },
              "agent_id": {
                "type": "string"
              },
              "constraints": {
                "type": "object"
              }
            }
          }
        },
        "process": {
          "description": "Return capacity + random property + constraints, or validate and apply a constraints update against the physical rules (world bounds, max step, non-negative resources).",
          "kind": "deterministic"
        },
        "output": {
          "logical_type": "AgentProfile",
          "description": "{capacity, random_property, constraints} or {ok:false, error:...}",
          "schema": null
        }
      },
      "ipp_executor": {
        "integrity": {
          "checksum_algorithm": "sha256",
          "signature_required": false,
          "verification_endpoint": null,
          "payload_validation_schema": {
            "type": "object",
            "required": [
              "op",
              "agent_id"
            ],
            "properties": {
              "op": {
                "type": "string"
              },
              "agent_id": {
                "type": "string"
              }
            }
          }
        },
        "policy": {
          "max_cost_per_call_usd": 0,
          "max_latency_ms": 30000,
          "rate_limit_rps": 0,
          "security_clearance": "social",
          "retry_policy": {
            "max_retries": 0,
            "backoff_strategy": "constant"
          }
        },
        "provenance": {
          "audit_level": "full",
          "log_endpoint": "graph_data/logs/IPP/social_activity.profile.jsonl",
          "chain_of_custody": true
        },
        "error_handling": {
          "fallback_nodes": [],
          "circuit_breaker": {
            "failure_threshold": 5,
            "recovery_timeout_ms": 30000
          },
          "escalation_policy": {
            "max_escalation_depth": 1,
            "escalation_delay_ms": 1000
          }
        },
        "edge_capabilities": {
          "upstream_compatible": [],
          "downstream_compatible": [],
          "routing_modes": [
            "unicast"
          ],
          "constraint_envelope": {
            "max_parallel_edges": 8,
            "acknowledgment": "optional",
            "backpressure_modes": [
              "block",
              "buffer"
            ],
            "resolution_policy": "constructor_resolved"
          }
        }
      }
    },
    {
      "channel_id": "tasks",
      "handler": "IPP_Social.IPP_Social_services_tools.IPP_Social_services_ipp_object:make_tasks_handler",
      "ipp_object": {
        "input": {
          "logical_type": "SocialOp",
          "description": "{op: create_goal|list_goals|get_goal|delete_goal|create_task|update_task|get_task|list_tasks, goal_id?, task_id?, ...} — shared goal/task management",
          "schema": {
            "type": "object",
            "anyOf": [
              {
                "description": "Create a shared goal folder.",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "owner_agent_id": {
                    "type": "string"
                  },
                  "goal_id": {
                    "type": "string"
                  },
                  "op": {
                    "const": "create_goal"
                  }
                },
                "required": [
                  "op",
                  "title"
                ]
              },
              {
                "description": "List the shared goal folders.",
                "properties": {
                  "op": {
                    "const": "list_goals"
                  }
                },
                "required": [
                  "op"
                ]
              },
              {
                "description": "Read one goal folder.",
                "properties": {
                  "goal_id": {
                    "type": "string"
                  },
                  "op": {
                    "const": "get_goal"
                  }
                },
                "required": [
                  "op",
                  "goal_id"
                ]
              },
              {
                "description": "Delete a goal folder.",
                "properties": {
                  "goal_id": {
                    "type": "string"
                  },
                  "op": {
                    "const": "delete_goal"
                  }
                },
                "required": [
                  "op",
                  "goal_id"
                ]
              },
              {
                "description": "Create a task inside a goal.",
                "properties": {
                  "goal_id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "assignee_agent_id": {
                    "type": "string"
                  },
                  "task_id": {
                    "type": "string"
                  },
                  "author_agent_id": {
                    "type": "string"
                  },
                  "depends_on": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "status": {
                    "type": "string"
                  },
                  "op": {
                    "const": "create_task"
                  }
                },
                "required": [
                  "op",
                  "goal_id",
                  "title"
                ]
              },
              {
                "description": "Update a task (status/note/assignee).",
                "properties": {
                  "goal_id": {
                    "type": "string"
                  },
                  "task_id": {
                    "type": "string"
                  },
                  "author_agent_id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "assignee_agent_id": {
                    "type": "string"
                  },
                  "op": {
                    "const": "update_task"
                  }
                },
                "required": [
                  "op",
                  "goal_id",
                  "task_id"
                ]
              },
              {
                "description": "Read one task (status/notes/VCL).",
                "properties": {
                  "goal_id": {
                    "type": "string"
                  },
                  "task_id": {
                    "type": "string"
                  },
                  "op": {
                    "const": "get_task"
                  }
                },
                "required": [
                  "op",
                  "goal_id",
                  "task_id"
                ]
              },
              {
                "description": "List a goal's tasks.",
                "properties": {
                  "goal_id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "op": {
                    "const": "list_tasks"
                  }
                },
                "required": [
                  "op"
                ]
              }
            ]
          }
        },
        "process": {
          "description": "A goal is a folder whose individual tasks are Markdown files (Version Control Log at the bottom). Any agent may create goals, create tasks, update status/notes/assignee — collaboration toward the goal.",
          "kind": "deterministic"
        },
        "output": {
          "logical_type": "GoalTask",
          "description": "a Goal, a Task, a list, or {ok:false, error:...}",
          "schema": null
        }
      },
      "ipp_executor": {
        "integrity": {
          "checksum_algorithm": "sha256",
          "signature_required": false,
          "verification_endpoint": null,
          "payload_validation_schema": {
            "type": "object",
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "type": "string"
              }
            }
          }
        },
        "policy": {
          "max_cost_per_call_usd": 0,
          "max_latency_ms": 30000,
          "rate_limit_rps": 0,
          "security_clearance": "social",
          "retry_policy": {
            "max_retries": 0,
            "backoff_strategy": "constant"
          }
        },
        "provenance": {
          "audit_level": "full",
          "log_endpoint": "graph_data/logs/IPP/social_activity.tasks.jsonl",
          "chain_of_custody": true
        },
        "error_handling": {
          "fallback_nodes": [],
          "circuit_breaker": {
            "failure_threshold": 5,
            "recovery_timeout_ms": 30000
          },
          "escalation_policy": {
            "max_escalation_depth": 1,
            "escalation_delay_ms": 1000
          }
        },
        "edge_capabilities": {
          "upstream_compatible": [],
          "downstream_compatible": [],
          "routing_modes": [
            "unicast"
          ],
          "constraint_envelope": {
            "max_parallel_edges": 8,
            "acknowledgment": "optional",
            "backpressure_modes": [
              "block",
              "buffer"
            ],
            "resolution_policy": "constructor_resolved"
          }
        }
      }
    },
    {
      "channel_id": "chat_board",
      "handler": "IPP_Social.IPP_Social_services_tools.IPP_Social_services_ipp_object:make_chat_board_handler",
      "ipp_object": {
        "input": {
          "logical_type": "SocialOp",
          "description": "{op: post|get|get_since|clear, author_agent_id, text?, tags?, to_agent_id?, scope?, limit?, after_id?} — the global chat board",
          "schema": {
            "type": "object",
            "anyOf": [
              {
                "description": "Post a message to the global chat board (broadcast or addressed).",
                "properties": {
                  "author_agent_id": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "to_agent_id": {
                    "type": "string",
                    "description": "'chat_board' | 'agents' | <agent_id>"
                  },
                  "op": {
                    "const": "post"
                  }
                },
                "required": [
                  "op",
                  "author_agent_id",
                  "text",
                  "to_agent_id"
                ]
              },
              {
                "description": "Read the latest chat board messages.",
                "properties": {
                  "limit": {
                    "type": "integer",
                    "description": "max messages"
                  },
                  "op": {
                    "const": "get"
                  }
                },
                "required": [
                  "op"
                ]
              },
              {
                "description": "Read board messages after a message id.",
                "properties": {
                  "after_id": {
                    "type": "integer"
                  },
                  "op": {
                    "const": "get_since"
                  }
                },
                "required": [
                  "op",
                  "after_id"
                ]
              },
              {
                "description": "Clear the chat board (scope: all|direct|broadcast).",
                "properties": {
                  "scope": {
                    "type": "string"
                  },
                  "op": {
                    "const": "clear"
                  }
                },
                "required": [
                  "op"
                ]
              }
            ]
          }
        },
        "process": {
          "description": "Post a message to every agent on the global chat board; a post also fans out push notifications to subscribers (the only push source).",
          "kind": "deterministic"
        },
        "output": {
          "logical_type": "ChatMessage",
          "description": "a Message, a list of Messages, or {ok:false, error:...}",
          "schema": null
        }
      },

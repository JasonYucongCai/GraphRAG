        "integrity": {
          "checksum_algorithm": "sha256",
          "signature_required": false,
          "verification_endpoint": null,
          "payload_validation_schema": {
            "type": "object",
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "type": "string"
              }
            }
          }
        },
        "policy": {
          "max_cost_per_call_usd": 0,
          "max_latency_ms": 30000,
          "rate_limit_rps": 0,
          "security_clearance": "social",
          "retry_policy": {
            "max_retries": 0,
            "backoff_strategy": "constant"
          }
        },
        "provenance": {
          "audit_level": "full",
          "log_endpoint": "graph_data/logs/IPP/social_activity.chat_board.jsonl",
          "chain_of_custody": true
        },
        "error_handling": {
          "fallback_nodes": [],
          "circuit_breaker": {
            "failure_threshold": 5,
            "recovery_timeout_ms": 30000
          },
          "escalation_policy": {
            "max_escalation_depth": 1,
            "escalation_delay_ms": 1000
          }
        },
        "edge_capabilities": {
          "upstream_compatible": [],
          "downstream_compatible": [],
          "routing_modes": [
            "unicast",
            "broadcast"
          ],
          "constraint_envelope": {
            "max_parallel_edges": 8,
            "acknowledgment": "optional",
            "backpressure_modes": [
              "block",
              "buffer"
            ],
            "resolution_policy": "constructor_resolved"
          }
        }
      }
    },
    {
      "channel_id": "events",
      "handler": "IPP_Social.IPP_Social_services_tools.IPP_Social_services_ipp_object:make_events_handler",
      "ipp_object": {
        "input": {
          "logical_type": "StreamQuery",
          "description": "{since?, live?, timeout_s?} — stream the social event bus; buffered by default, live iterator when live=true",
          "schema": null
        },
        "process": {
          "description": "Yield social events (agent joined, task updated, message posted, ...) as dicts; cursor = last event seq.",
          "kind": "deterministic"
        },
        "output": {
          "logical_type": "SocialEventStream",
          "description": "{mode: stream, events: [...], cursor: n} or a live SocialStream iterator",
          "schema": null
        }
      },
      "ipp_executor": {
        "integrity": {
          "checksum_algorithm": "sha256",

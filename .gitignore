# ══════════════════════════════════════════════════════════════════════════════
# Graph Knowledge Network for Agentic Work — .gitignore
# ══════════════════════════════════════════════════════════════════════════════
# Syntax: # comment · folder/ · *.ext · **/pattern · !negate · /root-anchored

# ─── 🔐 SECURITY: credentials — NEVER commit ⚠️ ───────────────────────────────
# LLMs/.env holds the real DeepSeek API key (DEEPSEEK_API_KEY=sk-...).
# If it was ever committed, ROTATE the key immediately.
.env
.env.*
.env.example
*.pem
*.key
secrets.*

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.so
*.egg-info/
*.egg
dist/
build/
.venv/
venv/
env/
.conda/
*.pyc

# ─── Jupyter ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints/
database/calabiyau3fold


# ─── Generated / runtime artifacts (regenerable) ────────────────────────────
# The knowledge graph + vector index are rebuilt per project by pipeline/build
# scripts and the server — they live in database/<project>/graph_data/
**/graph_data/
# Note-based projects are generated from the graph by database_tool — but the
# SPEC, the NoteStore engine and the database_tool module ARE committed
database/
!database/README.md
!database/notes.py
!database/database_tool/
# Chunk caches / exports
*.bak
chat_history/

# ─── Generated extraction outputs (regenerate with assets/scripts/*) ────────
assets/extracted/
assets/odl_output/
assets/odl_hybrid_output/
assets/docling_direct_output/
assets/previous-resources/
assets/
# ... but the README screenshots ARE committed
!assets/screenshot-graphrag.png
!assets/screenshot-multi-agent.png
!assets/screenshot-controlcenter-20260809.png
!assets/screenshot-multiagent-20260809.png
!assets/screenshot-recursiveagent-20260809.png

# ─── IDE / Editor ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.code-workspace

# ─── OS generated files ─────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ─── Logs & temp files ──────────────────────────────────────────────────────
*.log
*.tmp
*.temp
tmp/
temp/

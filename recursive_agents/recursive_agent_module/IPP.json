        },
        "process": {
          "description": "Run agent_plan → agent_generate → agent_create → agent_evaluate → agent_test → agent_deploy deterministically (no LLM). Parses the target agent from the task text.",
          "kind": "deterministic"
        },
        "output": {
          "logical_type": "OfflineResult",
          "description": "{ok, agent_id, steps: [{step, ok, content}], chain, constructed}",
          "schema": null

      "handler": "recursive_agents.recursive_agent_module.IPP_object:make_verify_handler",
      "ipp_object": {
        "input": {
          "logical_type": "VerifyRequest",
          "description": "{agent_id: str, check: str} — check = tool_count|recursive_capability|engine_comprehensiveness|ipp|test|all",
          "schema": {
            "type": "object",
            "required": [
              "agent_id"
            ],
            "properties": {
              "agent_id": {
                "type": "string"
              },
              "check": {
                "type": "string"
              }
            }
          }
        },
        "process": {
          "description": "Run a verification check against the specified agent using its own evaluation tools.",
          "kind": "deterministic"
        },
        "output": {
          "logical_type": "VerifyResult",
          "description": "{ok, content, metadata, error}",
          "schema": null

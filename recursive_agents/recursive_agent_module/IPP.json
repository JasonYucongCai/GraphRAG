              }
            }
          }
        },
        "process": {
          "description": "Compare two agents file-by-file. Returns identical/name-only/different categorized file lists.",
          "kind": "deterministic"
        },
        "output": {
          "logical_type": "DiffResult",
          "description": "{agent1, agent2, identical: [{file, detail}], name_only: [...], different: [...]}",
          "schema": null

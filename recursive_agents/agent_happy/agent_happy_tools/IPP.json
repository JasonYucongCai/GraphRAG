              "args": {
                "type": "object"
              }
            }
          }
        },
        "process": {
          "description": "Execute one tool through the agent's own toolkit registry; general tools delegate to the SHARED tools node's envelope (ACL enforced here).",
          "kind": "tool"
        },
        "output": {
          "logical_type": "ToolResult",
          "description": "{content, ok, error, metadata}",
          "schema": null

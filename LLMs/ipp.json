{
  "$schema": "https://ipp-spec.org/v0.2.8/schema.json",
  "ipp_version": "0.2.8",
  "node_id": "llm",
  "description": "The LLM provider node: three independent channels over the DeepSeek (or Mock) provider — chat, complete, chat_stream. Every channel is guarded by the executor envelope; every call is hash-chained into the audit log.",
  "channels": [
    {
      "channel_id": "chat",
      "handler": "LLMs.IPP_object:make_chat_handler",
      "ipp_object": {
        "input": {
          "logical_type": "ChatMessages",
          "description": "OpenAI-style message list (or {messages, tools?, temperature?, max_tokens?})",
          "schema": null
        },
        "process": {
          "description": "Call the DeepSeek Chat Completions API (OpenAI-compatible) with function-calling tools; return an LLMResult with content, tool_calls and usage.",
          "kind": "llm"
        },
        "output": {
          "logical_type": "LLMResult",
          "description": "{content, tool_calls, usage, model}",
          "schema": null
        }
      },
      "ipp_executor": {
        "integrity": {
          "checksum_algorithm": "sha256",
          "signature_required": false,
          "verification_endpoint": null,
          "payload_validation_schema": null
        },
        "policy": {
          "max_cost_per_call_usd": 0.01,
          "max_latency_ms": 120000,
          "rate_limit_rps": 0,
          "security_clearance": "api-key",
          "retry_policy": { "max_retries": 1, "backoff_strategy": "exponential" }
        },
        "provenance": {
          "audit_level": "full",
          "log_endpoint": "graph_data/logs/IPP/llm.chat.jsonl",
          "chain_of_custody": true
        },
        "error_handling": {
          "fallback_nodes": ["llm/complete"],
          "circuit_breaker": { "failure_threshold": 3, "recovery_timeout_ms": 60000 },
          "escalation_policy": { "max_escalation_depth": 1, "escalation_delay_ms": 1000 }
        },
        "edge_capabilities": {
          "upstream_compatible": [],
          "downstream_compatible": [
            { "node_class": "*", "input_logical_type": "LLMResult",
              "edge_count_range": { "min": 0, "max": 64 }, "compatibility": "any" }
          ],
          "routing_modes": ["unicast", "multicast"],
          "constraint_envelope": {
            "max_parallel_edges": 64, "acknowledgment": "optional",
            "backpressure_modes": ["block", "buffer"],
            "resolution_policy": "constructor_resolved"
          }
        }
      }
    },
    {
      "channel_id": "complete",
      "handler": "LLMs.IPP_object:make_complete_handler",
      "ipp_object": {
        "input": {
          "logical_type": "PromptPair",
          "description": "{system, user, temperature?}",
          "schema": null
        },
        "process": {
          "description": "Single-shot system+user completion returning plain text (used by growth proposals and JSON-only outputs).",
          "kind": "llm"
        },
        "output": {
          "logical_type": "Text",
          "description": "the completion text",
          "schema": null
        }
      },
      "ipp_executor": {
        "integrity": {
          "checksum_algorithm": "sha256",
          "signature_required": false,
          "verification_endpoint": null,
          "payload_validation_schema": null
        },
        "policy": {
          "max_cost_per_call_usd": 0.01,
          "max_latency_ms": 120000,
          "rate_limit_rps": 0,
          "security_clearance": "api-key",
          "retry_policy": { "max_retries": 1, "backoff_strategy": "exponential" }
        },
        "provenance": {
          "audit_level": "full",
          "log_endpoint": "graph_data/logs/IPP/llm.complete.jsonl",
          "chain_of_custody": true
        },
        "error_handling": {
          "fallback_nodes": [],
          "circuit_breaker": { "failure_threshold": 3, "recovery_timeout_ms": 60000 },
          "escalation_policy": { "max_escalation_depth": 1, "escalation_delay_ms": 1000 }
        },
        "edge_capabilities": {
          "upstream_compatible": [],
          "downstream_compatible": [
            { "node_class": "*", "input_logical_type": "Text",
              "edge_count_range": { "min": 0, "max": 64 }, "compatibility": "any" }
          ],
          "routing_modes": ["unicast"],
          "constraint_envelope": {
            "max_parallel_edges": 64, "acknowledgment": "optional",
            "backpressure_modes": ["block"],
            "resolution_policy": "constructor_resolved"
          }
        }
      }
    },
    {
      "channel_id": "chat_stream",
      "handler": "LLMs.IPP_object:make_chat_stream_handler",
      "ipp_object": {
        "input": {
          "logical_type": "ChatMessages",
          "description": "message list (or {messages, tools?})",
          "schema": null
        },
        "process": {
          "description": "Streaming Chat Completions: yield (kind, data) events as tokens arrive, accumulate an LLMResult.",
          "kind": "llm"
        },
        "output": {
          "logical_type": "EventStream",
          "description": "{events: [(kind, data)], result: LLMResult}",
          "schema": null
        }
      },
      "ipp_executor": {
        "integrity": {
          "checksum_algorithm": "sha256",
          "signature_required": false,
          "verification_endpoint": null,
          "payload_validation_schema": null
        },
        "policy": {
          "max_cost_per_call_usd": 0.01,
          "max_latency_ms": 300000,
          "rate_limit_rps": 0,
          "security_clearance": "api-key",
          "retry_policy": { "max_retries": 0, "backoff_strategy": "constant" }
        },
        "provenance": {
          "audit_level": "full",
          "log_endpoint": "graph_data/logs/IPP/llm.chat_stream.jsonl",
          "chain_of_custody": true
        },
        "error_handling": {
          "fallback_nodes": ["llm/chat"],
          "circuit_breaker": { "failure_threshold": 3, "recovery_timeout_ms": 60000 },
          "escalation_policy": { "max_escalation_depth": 1, "escalation_delay_ms": 1000 }
        },
        "edge_capabilities": {
          "upstream_compatible": [],
          "downstream_compatible": [
            { "node_class": "*", "input_logical_type": "EventStream",
              "edge_count_range": { "min": 0, "max": 64 }, "compatibility": "any" }
          ],
          "routing_modes": ["unicast"],
          "constraint_envelope": {
            "max_parallel_edges": 64, "acknowledgment": "optional",
            "backpressure_modes": ["buffer"],
            "resolution_policy": "constructor_resolved"
          }
        }
      }
    }
  ]
}
